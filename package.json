{
  "name": "software-clones-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "12 个克隆 App 的 Playwright 端到端套件 + 启动编排（后端 better-sqlite3 现已可运行，E2E 真正走通前端→后端→SQLite 全链路）。",
  "scripts": {
    "dev:all": "node scripts/start-all.mjs",
    "dev:app": "node scripts/start-app.mjs",
    "check:backends": "node scripts/check-backends.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "verify": "node scripts/verify-all.mjs",
    "test": "node scripts/verify-all.mjs",
    "test:app": "node scripts/verify-apps.mjs",
    "test:all": "node scripts/verify-apps.mjs",
    "test:rules": "node scripts/check-consistency.test.mjs",
    "catalog": "node scripts/gen-catalog.mjs",
    "fix": "node scripts/check-consistency.mjs --fix",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^26.1.2",
    "typescript": "^5.6.3"
  }
}
